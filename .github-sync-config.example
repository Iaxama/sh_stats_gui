# GitHub Data Sync Configuration
# Copy this file to .github-sync-config (do NOT commit to git)
# Set these environment variables or copy values below

# ============================================================
# AUTHENTICATION METHOD: Choose ONE
# ============================================================

# Option 1: SSH Authentication (Recommended)
# GitHub repository URL in SSH format
# Example: git@github.com:username/sh_stats_gui-data.git
# GIT_DATA_REPO_URL=git@github.com:iaxama/sh_data.git

# Path to SSH private key (optional, defaults to ~/.ssh/id_rsa)
# Only used with SSH URLs
# GIT_SSH_KEY_PATH=/home/user/.ssh/id_rsa

# Option 2: HTTPS with Personal Access Token (PAT)
# Uncomment the lines below and comment out SSH above
GIT_DATA_REPO_URL=your_repo_here
GIT_GITHUB_TOKEN=your_token_here

# ============================================================
# REQUIRED: Git Author Information
# ============================================================

# Git commit author name
GIT_AUTHOR_NAME="Data Sync"

# Git commit author email
GIT_AUTHOR_EMAIL=sync@example.com

# ============================================================
# OPTIONAL: Debugging
# ============================================================

# Enable debug logging for git operations
# GIT_SYNC_DEBUG=1
